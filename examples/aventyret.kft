# Writes "Hello, Äventyret" and stops. It reads nothing.
# Each letter is a number. The trail makes it out of a number it kept on the stack and
# writes it (white); orange first makes a copy where the number is wanted again.
# Ä is two bytes in UTF-8, 195 and 132.
# Five rows, 2400 apart, joined by one strip at each bend, as in dad.kft. Strips in a row
# lie end to end, 1000 apart, so that the whole trail fits on the stones.
red      1000      0
red      2000      0
red      3000      0
orange   4000      0
green    5000      0
orange   6000      0
orange   7000      0
green    8000      0
blue     9000      0
white   10000      0   # writes 72: H
red     11000      0
red     12000      0
red     13000      0
red     14000      0
red     15000      0
orange  16000      0
green   17000      0
orange  18000      0
blue    19000      0
red     20000      0
green   21000      0
white   22000      0   # writes 101: e
red     23000      0
red     24000      0
red     25000      0
orange  26000      0
orange  27000      0
green   28000      0
orange  28000   1200
blue    28000   2400
blue    27000   2400
