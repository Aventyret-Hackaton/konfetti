# countdown: reads one digit and writes the digits from it down to 1.
# 5 -> 54321. The ring writes before it tests, so 0 -> 0.
# The on-ramp makes 48 (the character 0) and keeps it in the stash,
# turns the digit into a number n, copies it and joins the ring at gold
# from behind: arriving from either side, the ring's next strip is the
# smallest turn.
red      1200     0   # 1
red      2400     0   # 2
red      3600     0   # 3
red      4800     0   # 4
red      6000     0   # 5
red      7200     0   # 6
red      8400     0   # 7
orange   8400  1200   # 7 7
blue     8400  2400   # 49
red      7200  2400   # 49 1
cyan     6000  2400   # 48
orange   4800  2400   # 48 48
silver   3600  2400   # 48            stash 48
black    2400  2400   # 48 c          (c = 53 for the digit 5)
yellow   1200  2400   # c 48
cyan     1200  3600   # n             (n = c - 48)
orange   1200  4800   # n n           on-ramp ends, joins the ring
gold     2650  4500   # n n 48        stash empty     (ring: join here)
orange   3850  4500   # n n 48 48
silver   5050  4500   # n n 48        stash 48
green    6250  4500   # n n+48
white    6250  5700   # n             writes the digit
red      6250  6900   # n 1
cyan     5050  6900   # n-1
orange   3850  6900   # n-1 n-1
pink     2650  6900   # n-1   positive: left, round again; zero: straight on
orange   2650  5700   # n-1 n-1       back to gold
brown    1450  6900   # (zero) dead end, halt
