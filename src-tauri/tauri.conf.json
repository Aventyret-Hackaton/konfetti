{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konfetti",
  "version": "0.0.10",
  "identifier": "io.github.aventyret-hackaton.konfetti",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "konfetti",
        "url": "web/index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: https://api.open-meteo.com",
      "dangerousDisableAssetCspModification": ["style-src"],
      "capabilities": [{ "identifier": "editor", "windows": ["main"], "permissions": ["allow-location", "allow-save"] }]
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": ["icons/icon@2x.png"],
    "category": "Education",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
